# =================================================================
# InLEAGLE - Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# =================================================================

# ── Groq LLM API ────────────────────────────────────────────────
# Required for legal RAG generation and query reformulation
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
MAX_RESPONSE_TOKENS=400

# ── Qdrant Cloud Vector Database ────────────────────────────────
# Endpoint and API key from cloud.qdrant.io
QDRANT_CLOUD_CLUSTER_URL=https://your-cluster-id.us-west-2-0.aws.cloud.qdrant.io
QDRANT_CLOUD_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=Inleagle01

# ── Embeddings & Cache ──────────────────────────────────────────
# Pre-trained domain-adapted Indian legal BERT embeddings
EMBEDDING_MODEL=bhavyagiri/InLegal-Sbert
# Cache directory for model weights (use /app/hf_cache in Docker)
HF_HOME=/app/hf_cache

# ── Server Port (Optional, defaults to 7860) ────────────────────
PORT=7860

