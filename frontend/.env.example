# The React app talks to the backend through the Vite dev proxy, so this stays
# empty during development. Set it only when the frontend is deployed on a
# different origin from the API (e.g. Vercel frontend + Hugging Face backend).
VITE_API_BASE=

# Where the Vite dev proxy forwards /query and /health.
# Defaults to http://localhost:7860 when unset.
INLEAGLE_API_URL=http://localhost:7860
